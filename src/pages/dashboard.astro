---
import DashboardPageApp from '../components/DashboardPageApp';
import '../styles/miraka-portal.css';
import '../styles/miraka-dashboard.css';
---

<!DOCTYPE html>
<html transition:name="root" transition:animate="none" lang="de">
<head>
  <script is:inline>
    (() => {
      window.__OPC_NO_MOTION_VIEW_TRANSITIONS__ = true;

      const noMotionTransition = (input) => {
        const update =
          typeof input === 'function'
            ? input
            : input && typeof input.update === 'function'
              ? input.update
              : null;

        let updateCallbackDone;
        try {
          updateCallbackDone = Promise.resolve(update ? update() : undefined);
        } catch (error) {
          updateCallbackDone = Promise.reject(error);
        }

        return {
          ready: Promise.resolve(),
          updateCallbackDone,
          finished: updateCallbackDone.then(() => undefined),
          skipTransition() {},
          types: new Set(
            input && typeof input === 'object' && Array.isArray(input.types)
              ? input.types
              : []
          ),
        };
      };

      try {
        Object.defineProperty(document, 'startViewTransition', {
          configurable: true,
          writable: true,
          value: noMotionTransition,
        });
      } catch {
        document.startViewTransition = noMotionTransition;
      }
    })();
  </script>

  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="icon" type="image/png" href="/icons/orange-pro-clean-webicon.png" />
  <link rel="shortcut icon" type="image/png" href="/icons/orange-pro-clean-webicon.png" />
  <link rel="apple-touch-icon" href="/icons/orange-pro-clean-webicon.png" />

  <meta name="theme-color" content="#ff6a00" />
  <meta name="application-name" content="Orange Pro Clean" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="Orange Pro Clean" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard | Orange Pro Clean</title>
  <link rel="icon" type="image/png" href="/favicon.ico" />
</head>
<body>
  <DashboardPageApp client:only="react" />
</body>
</html>
