---
import Layout from '../../layouts/main.astro';
import MirakaDashboardShell from '../../components/MirakaDashboardShell';
import SafeClientDetail from '../../components/SafeClientDetail';
import { baseUrl } from '../../lib/base-url';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect(`${baseUrl}/kunden`);
}
---

<Layout>
  <MirakaDashboardShell
    client:only="react"
    requiredRole={["owner", "admin", "dispatch"]}
    currentPath={`/kunde/${id}`}
    hideTopBar={true}
  >
    <SafeClientDetail client:only="react" clientId={id} baseUrl={baseUrl} />
  </MirakaDashboardShell>
</Layout>