---
import MirakaDashboardShell from '../components/MirakaDashboardShell';
import TicketsPageTranslated from '../components/TicketsPageTranslated';

export const prerender = false;
---

<!DOCTYPE html>
<html transition:name="root" transition:animate="none" lang="de">
<head>
    <script is:inline>
    (() => {
      if (window.__OPC_NO_MOTION_VIEW_TRANSITIONS__) return;

      window.__OPC_NO_MOTION_VIEW_TRANSITIONS__ = true;

      const noMotionTransition = (callback) => {
        let callbackResult;

        try {
          callbackResult = typeof callback === 'function' ? callback() : undefined;
        } catch (error) {
          const rejected = Promise.reject(error);

          return {
            ready: rejected,
            updateCallbackDone: rejected,
            finished: rejected,
            skipTransition() {},
          };
        }

        const done = Promise.resolve(callbackResult);

        return {
          ready: done,
          updateCallbackDone: done,
          finished: done,
          skipTransition() {},
        };
      };

      try {
        Object.defineProperty(document, 'startViewTransition', {
          configurable: true,
          writable: true,
          value: noMotionTransition,
        });
      } catch {
        document.startViewTransition = noMotionTransition;
      }
    })();
  </script>

  <script is:inline>
    (() => {
      if (window.__OPC_INQUIRY_DETAIL_LOCATION_PATCH__) return;
      window.__OPC_INQUIRY_DETAIL_LOCATION_PATCH__ = true;

      const REQUESTS_PAGE_CACHE_KEY = 'opc:page-cache:requests:v14-schema-aware-progressive';

      const clean = (value) => String(value ?? '').trim();
      const isMissing = (value) => {
        const normalized = clean(value).toLowerCase();
        return !normalized || normalized === '—' || normalized === '-' || normalized === 'null' || normalized === 'undefined';
      };
      const normalizePhone = (value) => clean(value).replace(/\D/g, '');

      const readCachedItems = () => {
        try {
          const raw = window.sessionStorage.getItem(REQUESTS_PAGE_CACHE_KEY);
          if (!raw) return [];
          const parsed = JSON.parse(raw);
          return Array.isArray(parsed?.data?.items) ? parsed.data.items : [];
        } catch {
          return [];
        }
      };

      const findPreviewBox = (modal, label) => {
        return Array.from(modal.querySelectorAll('.opc-preview-box')).find((box) => {
          return clean(box.querySelector('span')?.textContent).toLowerCase() === label.toLowerCase();
        });
      };

      const getBoxValue = (box) => clean(box?.querySelector('strong')?.textContent);

      const findCachedInquiry = (modal) => {
        const items = readCachedItems();
        if (!items.length) return null;

        const title = clean(modal.querySelector('.opc-modal-head h2')?.textContent);
        const email = getBoxValue(findPreviewBox(modal, 'E-Mail'));
        const phone = normalizePhone(getBoxValue(findPreviewBox(modal, 'Telefon')));

        if (email && email !== '—') {
          const byEmail = items.find((item) => clean(item?.email).toLowerCase() === email.toLowerCase());
          if (byEmail) return byEmail;
        }

        if (phone) {
          const byPhone = items.find((item) => {
            const itemPhone = normalizePhone(item?.phoneE164 || item?.phoneRaw);
            return itemPhone && itemPhone === phone;
          });
          if (byPhone) return byPhone;
        }

        if (title) {
          return items.find((item) => clean(item?.title) === title || clean(item?.clientName) === title) || null;
        }

        return null;
      };

      const uniqueParts = (values) => {
        const seen = new Set();
        return values
          .map(clean)
          .filter(Boolean)
          .filter((value) => {
            const key = value.toLowerCase();
            if (seen.has(key)) return false;
            seen.add(key);
            return true;
          });
      };

      const patchInquiryModal = (modal) => {
        if (!(modal instanceof HTMLElement) || !modal.querySelector('.opc-preview-grid')) return;

        const item = findCachedInquiry(modal);
        if (!item) return;

        const locationBox = findPreviewBox(modal, 'Standort');
        const addressBox = findPreviewBox(modal, 'Adresse');
        const locationValue = getBoxValue(locationBox);
        const addressValue = getBoxValue(addressBox);

        if (locationBox && isMissing(locationValue)) {
          const zipCity = uniqueParts([item?.postalCode, item?.city]).join(' ');
          const baseLocation = clean(item?.locationLine) || uniqueParts([
            item?.objectTypeLabel || item?.siteName,
            item?.addressText,
            zipCity,
          ]).join(' · ');

          const detailParts = uniqueParts([
            baseLocation,
            item?.surfaceLabel ? `${item.surfaceLabel} m²` : '',
            item?.roomCount ? `${item.roomCount} Zimmer` : '',
            item?.floorLabel ? `Etage ${item.floorLabel}` : '',
            item?.elevatorLabel,
          ]);

          const strong = locationBox.querySelector('strong');
          if (strong && detailParts.length) strong.textContent = detailParts.join(' · ');
        }

        if (addressBox && isMissing(addressValue)) {
          const zipCity = uniqueParts([item?.postalCode, item?.city]).join(' ');
          const addressParts = uniqueParts([item?.addressText, zipCity || item?.city]);
          const strong = addressBox.querySelector('strong');
          if (strong && addressParts.length) strong.textContent = addressParts.join(', ');
        }
      };

      const scan = () => {
        document.querySelectorAll('.opc-modal-card').forEach(patchInquiryModal);
      };

      const runtimeKey = '__opcInquiryModalPatchRuntimeCleanup__';

      if (typeof window !== 'undefined' && typeof window[runtimeKey] === 'function') {
        window[runtimeKey]();
      }

      let observer = null;
      let started = false;

      const stop = () => {
        if (observer) {
          observer.disconnect();
          observer = null;
        }

        started = false;
        document.removeEventListener('astro:page-load', start);
        document.removeEventListener('astro:before-swap', stop);

        if (typeof window !== 'undefined' && window[runtimeKey] === stop) {
          delete window[runtimeKey];
        }
      };

      const start = () => {
        if (started) {
          scan();
          return;
        }

        started = true;
        scan();

        observer = new MutationObserver(scan);
        observer.observe(document.documentElement, { childList: true, subtree: true });

        document.addEventListener('astro:before-swap', stop, { once: true });
      };

      if (typeof window !== 'undefined') {
        window[runtimeKey] = stop;
      }

      queueMicrotask(start);
      document.addEventListener('astro:page-load', start);
    })();
  </script>

  <!-- Orange Pro Clean Web App / PWA -->
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="icon" type="image/png" href="/icons/orange-pro-clean-webicon.png" />
  <link rel="shortcut icon" type="image/png" href="/icons/orange-pro-clean-webicon.png" />
  <link rel="apple-touch-icon" href="/icons/orange-pro-clean-webicon.png" />

  <meta name="theme-color" content="#ff6a00" />
  <meta name="application-name" content="Orange Pro Clean" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="Orange Pro Clean" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
<meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Anfragen | Orange Pro Clean</title>
</head>

<body>
  <MirakaDashboardShell
    client:only="react"
    requiredRole={['owner', 'admin']}
    currentPath="/anfragen"
    fullWidth={true}
    hideTopBar={true}
  >
    <TicketsPageTranslated client:only="react" />
  </MirakaDashboardShell>
</body>
</html>

<style>
  :global(html),
  :global(body) {
    margin: 0;
    padding: 0;
    background: #ffffff;
    font-family: Inter, Helvetica, Arial, sans-serif;
  }

  :global(*) {
    box-sizing: border-box;
  }
</style>
