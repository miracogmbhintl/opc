---
import Layout from '../layouts/main.astro';
import { NotFound } from '../site-components/NotFound';
import { DevLinkProvider } from '../site-components/DevLinkProvider';
import '../site-components/global.css';
---

<Layout>
  <div id="not-found-root" style="min-height: 100vh; width: 100%; display: flex; align-items: center; justify-content: center;"></div>

  <script>
    import { createRoot, type Root } from 'react-dom/client';
    import { createElement } from 'react';
    import { DevLinkProvider } from '../site-components/DevLinkProvider';
    import { NotFound } from '../site-components/NotFound';
    import '../site-components/global.css';

    type Opc404RuntimeWindow = Window & {
      __OPC_404_RUNTIME__?: {
        mount: () => void;
        unmount: () => void;
      };
    };

    const runtimeWindow = window as Opc404RuntimeWindow;

    if (!runtimeWindow.__OPC_404_RUNTIME__) {
      let rootInstance: Root | null = null;
      let mountedElement: HTMLElement | null = null;

      const unmount = () => {
        if (rootInstance) {
          try {
            rootInstance.unmount();
          } catch {
            // The DOM swap may already have removed the previous root.
          }
        }

        rootInstance = null;
        mountedElement = null;
      };

      const mount = () => {
        const root = document.getElementById('not-found-root');
        if (!root) {
          unmount();
          return;
        }

        if (rootInstance && mountedElement === root) return;
        unmount();

        mountedElement = root;
        rootInstance = createRoot(root);
        rootInstance.render(
          createElement(
            DevLinkProvider,
            null,
            createElement(NotFound),
          ),
        );
      };

      runtimeWindow.__OPC_404_RUNTIME__ = { mount, unmount };
      document.addEventListener('astro:page-load', mount);
      document.addEventListener('astro:before-swap', unmount);
    }

    runtimeWindow.__OPC_404_RUNTIME__.mount();
  </script>
</Layout>

<style is:global>
  #not-found-root {
    min-height: 100vh;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: visible;
  }

  .utility-page-wrap {
    width: 100%;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    box-sizing: border-box;
  }

  .utility-page-content {
    text-align: center;
    max-width: 600px;
    width: 100%;
  }

  body:has(#not-found-root) {
    overflow: visible !important;
    min-height: 100vh;
  }
</style>
