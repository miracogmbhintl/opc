---
import DashboardLayout from '../../components/DashboardLayout';
import FilesPage from '../../components/FilesPage';
import '../../styles/global.css';
---

<script is:inline>
  // OPC_RESTRICTED_SALES_ADMIN_PAGE_BLOCKER_V1
  (() => {
    const blockedTerms = [
      '71a46f9a-357d-4283-a225-d37cd67a3d24',
      '6077d66c-5030-4e14-b0f4-51140066ca59',
      'pino@orangeproclean.ch',
      'wirth@orangeproclean.ch',
      'OPC-MA-000017',
      'OPC-MA-000018',
    ];

    try {
      const haystack = [
        ...Object.keys(localStorage || {}).map((key) => localStorage.getItem(key) || ''),
        ...Object.keys(sessionStorage || {}).map((key) => sessionStorage.getItem(key) || ''),
      ].join(' ').toLowerCase();

      const blocked = blockedTerms.some((term) =>
        haystack.includes(String(term).toLowerCase())
      );

      if (blocked) {
        window.location.replace('/dashboard');
      }
    } catch {
      // no-op
    }
  })();
</script>


<!DOCTYPE html>
<html lang="en">
<head>
  
  <!-- Orange Pro Clean Web App / PWA -->
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="icon" type="image/png" href="/icons/orange-pro-clean-webicon.png" />
  <link rel="shortcut icon" type="image/png" href="/icons/orange-pro-clean-webicon.png" />
  <link rel="apple-touch-icon" href="/icons/orange-pro-clean-webicon.png" />

  <meta name="theme-color" content="#ff6a00" />
  <meta name="application-name" content="Orange Pro Clean" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-title" content="Orange Pro Clean" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
<meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Files - Miraka & Co</title>
  <link rel="icon" type="image/png" href="/favicon.ico" />
</head>
<body style="margin: 0; padding: 0;">
  <FilesPage client:only="react" />
</body>
</html>
