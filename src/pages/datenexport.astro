---
import MirakaDashboardShell from '../components/MirakaDashboardShell';
import OwnerDataExportButton from '../components/OwnerDataExportButton';
import '../styles/miraka-portal.css';
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ff6a00" />
    <title>Datenexport | Orange Pro Clean</title>
  </head>
  <body>
    <MirakaDashboardShell
      client:only="react"
      title="Datenexport"
      requiredRole={['owner']}
      currentPath="/datenexport"
      fullWidth={true}
    >
      <section style="max-width:980px;margin:0 auto;padding:28px 22px 48px;font-family:-apple-system,BlinkMacSystemFont,'SF Pro Text','Inter','Helvetica Neue',Arial,sans-serif;">
        <div style="background:#fff;border:1px solid #e5e7eb;border-radius:20px;padding:24px;box-shadow:0 1px 2px rgba(15,17,21,.04);">
          <div style="font-size:12px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;color:#f97316;margin-bottom:8px;">Owner · Datensicherung</div>
          <h1 style="margin:0 0 10px;font-size:28px;line-height:1.15;color:#111827;">Unternehmensdaten exportieren</h1>
          <p style="margin:0 0 22px;color:#6b7280;line-height:1.55;max-width:760px;">
            Erstellt den vollständigen Orange-Pro-Clean-Unternehmensdatenbestand als aufbereitete CSV-Dateien und sendet ihn nach der bestehenden Sicherheitsprüfung an die hinterlegte Owner-E-Mail-Adresse.
          </p>
          <OwnerDataExportButton client:only="react" scope="all" label="Gesamten Datenbestand per E-Mail anfordern" />
        </div>
      </section>
    </MirakaDashboardShell>
  </body>
</html>
