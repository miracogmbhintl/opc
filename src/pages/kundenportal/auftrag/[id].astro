---
import OpcClientPortalApp from '../../../components/OpcClientPortalApp';
import '../../../styles/miraka-portal.css';

export const prerender = false;

const itemId = Astro.params.id;
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#ff7a00" />
  <meta name="application-name" content="Orange Pro Clean Kundenportal" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="icon" type="image/png" href="/icons/orange-pro-clean-webicon.png" />
  <link rel="apple-touch-icon" href="/icons/orange-pro-clean-webicon.png" />
  <title>Auftragsdetails | Orange Pro Clean</title>
</head>
<body>
  <OpcClientPortalApp client:only="react" section="order-detail" itemId={itemId} />
</body>
</html>
