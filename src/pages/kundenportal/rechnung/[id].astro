---
import OpcClientPortalApp from '../../../components/OpcClientPortalApp';

export const prerender = false;
const { id } = Astro.params;
---

<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#FF7A00" />
    <title>Rechnung | Orange Pro Clean</title>
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/png" href="/icons/orange-pro-clean-webicon.png" />
    <link rel="apple-touch-icon" href="/icons/orange-pro-clean-webicon.png" />
  </head>
  <body>
    <OpcClientPortalApp client:only="react" section="invoice-detail" itemId={id} />
  </body>
</html>
